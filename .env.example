# =========================================================================
# Mock Tracker — environment variables
# =========================================================================
# Copy this file to `.env` for local dev, and set the same keys in the Vercel
# project settings (Project → Settings → Environment Variables) for production.
# =========================================================================

# --- Database ------------------------------------------------------------
# LOCAL DEV: a SQLite file. The app uses this by default — no setup needed.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# PRODUCTION (Vercel): point at a hosted Postgres. Use the pooled connection
# string from your provider (Neon / Supabase / Vercel Postgres). Must start
# with "postgres" so the build picks the Postgres Prisma client.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Backups (optional) --------------------------------------------------
# Where to write JSON backup files. Default: /home/z/my-project/download/backups
# On Vercel this is automatically skipped (no writable FS); the Postgres DB
# is the source of truth there. Only set if you mount a persistent volume.
# BACKUP_DIR="/tmp/backups"

# --- Auto-restore on startup (optional) ---------------------------------
# Set to "1" to disable the dev-mode auto-restore-from-backup logic.
# Already auto-disabled on Vercel; only set manually if you host elsewhere
# and want to skip it.
# DISABLE_AUTO_RESTORE="1"
